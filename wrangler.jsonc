// One-click deploy config for the "Deploy to Cloudflare" button and self-hosters
// deploying into their own Cloudflare account (`pnpm run build && pnpm --filter
// @flow/api exec wrangler deploy --config ../../wrangler.jsonc`, never against
// this checkout's production Worker — Joel's production uses macOS-guarded
// `pnpm run deploy` with gitignored apps/api/wrangler.jsonc and never falls back
// to this file).
//
// Names the Worker "flow-selfhost-example" so a self-hoster deploying from this
// template never collides with an existing "flow" Worker. Serves Flow from a
// *.workers.dev hostname with sign-in unconfigured until ACCESS_TEAM_DOMAIN,
// ACCESS_AUD and OWNER_EMAIL are set in the Worker's Settings → Variables; for
// a custom domain and email sending, copy apps/api/wrangler.example.jsonc to
// apps/api/wrangler.jsonc instead (see docs/SELF_HOSTING.md).
{
  "$schema": "./apps/api/node_modules/wrangler/config-schema.json",
  "name": "flow-selfhost-example",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API/MCP/inbound routes must always hit the Worker, never the SPA shell.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
  // No send_email binding here: it needs Email Sending onboarding first, and
  // EMAIL_DRY_RUN keeps every send a log line until then. Add it from
  // apps/api/wrangler.example.jsonc when you're ready to send mail.
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "flow-attachments" }],
  "queues": {
    "producers": [{ "binding": "SIDE_EFFECTS", "queue": "flow-side-effects" }],
    "consumers": [
      { "queue": "flow-side-effects", "max_retries": 5, "dead_letter_queue": "flow-dlq" },
      { "queue": "flow-dlq", "max_retries": 3 }
    ]
  },
  // Values you set in the dashboard (Settings → Variables) survive the
  // redeploy every push to your copy of the repo triggers.
  "keep_vars": true,
  "vars": {
    "EMAIL_DRY_RUN": "true",
    "APP_HOSTNAME": "flow.example.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "owner@example.com",
    "EMAIL_FROM": "flow@mail.example.com",
    "EMAIL_FROM_NAME": "Flow",
    "EMAIL_BRAND_NAME": "Flow",
    "GLEAP_ATTACHMENT_HOSTS": ".gleap.io",
    "EMAIL_INTAKE_DOMAIN": "",
    "EMAIL_INTAKE_ACK": "false",
    "EMAIL_INTAKE_REPLY": "false"
  },
  "observability": { "enabled": true }
}
