{
  "name": "@flow/importer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "importer": "tsx src/index.ts",
    "extract": "tsx src/index.ts extract",
    "transform": "tsx src/index.ts transform",
    "load": "tsx src/index.ts load"
  },
  "dependencies": {
    "@flow/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
